# Copier ce fichier en .env et adapter les valeurs

# Base de donnees MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=movia_db

# JWT
JWT_SECRET=change_moi_en_production
JWT_EXPIRES_IN=1d

# Google Sign-In
# Doit etre EXACTEMENT le meme Client ID que celui utilise par le frontend
# (composant <GoogleLogin> de @react-oauth/google), sinon la verification echoue.
# A creer sur https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# Email (mot de passe oublie)
# Si SMTP_HOST est laisse vide, le lien de reinitialisation est simplement
# affiche dans les logs du serveur (pratique pour tester sans vraie boite mail).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@movia-automobile.sn

# URL du frontend, utilisee pour construire le lien de reinitialisation
FRONTEND_URL=http://localhost:5173

# Serveur
PORT=3000
NODE_ENV=development
